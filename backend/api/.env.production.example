# Production settings for the SocialHub API. Copy to `.env` on the server and fill in
# the blanks. Never commit the real file.

APP_NAME=SocialHub
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false               # must stay false: it controls whether errors show details
APP_URL=https://api.example.com
APP_LOCALE=vi

# Behind a load balancer / reverse proxy: `*` or a comma separated list of its addresses.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MariaDB 10.6+ (or MySQL 8). The runtime account only needs SELECT/INSERT/UPDATE/DELETE
# (see database/create-db-user.sh --dml-only); run migrations with a more privileged
# account by overriding DB_USERNAME / DB_PASSWORD for that one command.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=socialhub
DB_USERNAME=socialhub_app
DB_PASSWORD=

# Notifications and image clean-up run on the queue: keep a worker running
# (backend/deploy/supervisor-queue-worker.conf).
QUEUE_CONNECTION=database
# The rate limiter uses the cache. `file` is fine on ONE server; with several servers
# use a shared store (redis, or `database` after `php artisan cache:table && migrate`).
CACHE_STORE=file
SESSION_DRIVER=file

# Uploaded images (avatars, posts, stories). The files must be publicly readable by URL
# (bucket policy or CDN), because the API returns the disk's url() as the image address.
IMAGES_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=                      # public base URL of the bucket or CDN
# For an S3-compatible service (MinIO, R2, Spaces, ...):
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=true

BCRYPT_ROUNDS=12
